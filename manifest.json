{
  "name": "ChatGPT Prompt Link Generator",
  "version": "1.1.0",
  "description": "Generate a shareable ChatGPT prompt link from highlighted text.",
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "notifications",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Prompt Link Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
